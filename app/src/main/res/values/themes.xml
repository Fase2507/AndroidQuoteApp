<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidQuoteApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="android:statusBarColor">@color/md_theme_light_primary</item>
        <item name="android:windowBackground">@color/md_theme_light_background</item>
    </style>

    <style name="Theme.AndroidQuoteApp" parent="Base.Theme.AndroidQuoteApp" />

    <!-- This style makes the logo appear the instant the app is opened -->
    <style name="Theme.AndroidQuoteApp.Login" parent="Theme.AndroidQuoteApp">
        <item name="android:windowBackground">@drawable/mbl_logo</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
